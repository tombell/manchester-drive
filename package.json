{
  "name": "manchester-drive",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/server/index.ts",
    "start": "bun src/server/index.ts",
    "build": "bun build --compile --production --minify src/server/index.ts --outfile dist/manchester-drive",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "load:server": "bun scripts/load-server.ts",
    "load:test": "BUN_CONFIG_MAX_HTTP_REQUESTS=1024 bun scripts/load-test.ts"
  },
  "dependencies": {
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
